# Neo4j local (docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=compgraph_password
NEO4J_DATABASE=neo4j

# Dimensão fixa para manter compatibilidade entre o índice e os embeddings.
# hash = modo offline; sentence-transformers = embeddings semânticos multilíngues.
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSIONS=384
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Opcional: modelo local via Ollama (sem chave/API paga).
LLM_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

TOP_K_DOCUMENTS=5
MAX_GRAPH_HOPS=2
MIN_CONFIDENCE=0.18
